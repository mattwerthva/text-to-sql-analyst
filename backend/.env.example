# Copy to .env and fill in. Never commit .env.

# App
APP_NAME=text-to-sql-analyst
ENVIRONMENT=development

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Anthropic (required for /api/ask) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8   # swap to claude-haiku-4-5 while iterating

# --- Database (matches db/.env.example + db/docker-compose.yml) ---
DATABASE_URL=postgresql://dev:devpass@localhost:5432/sandbox

# --- Guardrails ---
# SQL_ROW_LIMIT=500
# SQL_STATEMENT_TIMEOUT_MS=5000
